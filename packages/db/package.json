{
  "name": "@beamy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "migrate:ci": "tsx src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "import-propuesta": "tsx --env-file=../../.env scripts/import-propuesta.ts",
    "seed-polanco": "tsx --env-file=../../.env scripts/seed-polanco.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.29.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
