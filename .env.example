# Postgres connection string. For local Supabase use the value from `supabase status`.
# Required by packages/db (Drizzle client + migration runner).
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Supabase project (web app + auth) — fill in once you create the project.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
