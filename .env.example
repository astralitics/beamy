# Postgres connection string. For local Supabase use the value from `supabase status`.
# Required by packages/db (Drizzle client + migration runner).
# Beamy uses port 54522 (Riffy: 54322, Cadenza: 54422) so all three can run locally.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54522/postgres

# Supabase project (web app + auth) — fill in once you create the project.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Dev mode: tRPC context is built with this user id when no real auth is wired.
# Defaults to the seeded "00000000-0000-0000-0000-000000000001" dev user.
# Override only if you've seeded an additional user via packages/db/src/seed.ts.
# BEAMY_DEV_USER_ID=00000000-0000-0000-0000-000000000001
