# Postgres connection string. For local Supabase use the value from `supabase status`.
# Required by packages/db (Drizzle client + migration runner).
# Beamy uses port 54522 (Riffy: 54322, Cadenza: 54422) so all three can run locally.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54522/postgres

# Supabase — for local dev, copy these from `supabase status` output.
# VITE_*  → exposed to the client bundle (anon/publishable key only)
# SUPABASE_SERVICE_ROLE_KEY → server-side, used by the vite-middleware tRPC
# handler to verify Bearer JWTs. Never commit this.
VITE_SUPABASE_URL=http://127.0.0.1:54521
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54521
SUPABASE_SERVICE_ROLE_KEY=

# Dev mode fallback: when no Authorization header is sent (i.e., no signed-in
# user), tRPC context is built with this user id. Defaults to the seeded
# "00000000-0000-0000-0000-000000000001" dev user. Real Supabase JWTs
# supersede this — no need to disable it once auth works.
# BEAMY_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Anthropic API key — used by the project assistant (chat) and the AI
# document intake (factura / cotización extraction).
# Server-side only. Get one at https://console.anthropic.com/
# When unset, those endpoints return a clear error rather than silently
# failing.
ANTHROPIC_API_KEY=
# Override the chat assistant model if you want; defaults to the latest Sonnet.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Override the document-extraction model; defaults to claude-sonnet-4-6.
# Vision-capable model required (reads PDFs / photos of invoices & quotes).
# EXTRACTION_MODEL=claude-sonnet-4-6
